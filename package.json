{
  "name": "hotlah",
  "private": true,
  "type": "module",
  "astryx": {
    "theme": "neutral"
  },
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1",
    "build": "react-router build",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:android-config": "node --test tests/android-assetlinks.test.mjs",
    "test:e2e": "playwright test",
    "android:assetlinks": "node scripts/android-assetlinks.mjs",
    "db:migrate": "wrangler d1 migrations apply hotlah --local",
    "db:seed": "wrangler d1 execute hotlah --local --file=./database/seed.sql",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.2",
    "@astryxdesign/theme-neutral": "^0.6.2",
    "@fontsource-variable/manrope": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@stylexjs/stylex": "^0.19.1",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "isbot": "^5",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "timepicker-ui": "4.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.6.2",
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/workers-types": "^5.20260920.1",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@react-router/node": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  }
}
